# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# VS Code extension build and packaging output
editors/vscode/node_modules/
editors/vscode/dist/
editors/vscode/server/
editors/vscode/*.vsix

# JetBrains extension build, IDE sandbox, and packaging output
editors/jetbrains/.gradle/
editors/jetbrains/.intellijPlatform/
editors/jetbrains/.kotlin/
editors/jetbrains/build/
editors/jetbrains/out/
editors/jetbrains/.idea/
editors/jetbrains/*.zip
